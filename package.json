{
  "name": "nick",
  "version": "0.1.0",
  "private": true,
  "description": "NICK — Natural-language Intelligence for Contextual Knowledge. A local, zero-cost AI agent with a real MCP server (Streamable HTTP), SQLite memory and task tools.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n mcp,web -c cyan,magenta \"npm:dev:mcp\" \"npm:dev:web\"",
    "dev:mcp": "tsx watch server/index.ts",
    "dev:web": "next dev --port 3000 --hostname 127.0.0.1",
    "start:mcp": "tsx server/index.ts",
    "build": "next build",
    "start": "concurrently -k -n mcp,web -c cyan,magenta \"npm:start:mcp\" \"next start --port 3000 --hostname 127.0.0.1\"",
    "db:init": "tsx scripts/db-init.ts",
    "check:ollama": "tsx scripts/check-ollama.ts",
    "smoke:mcp": "tsx scripts/mcp-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "tsx scripts/live-e2e.ts",
    "test:ui": "tsx scripts/ui-e2e.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "playwright-core": "1.64.1",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
