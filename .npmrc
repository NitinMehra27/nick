# better-sqlite3 ships prebuilt binaries for Windows, macOS and Linux, but when npm installs it
# from package-lock.json it tries to compile it with node-gyp, which fails on PCs without the
# Visual Studio C++ build tools. No dependency NICK uses needs an install script, so skip them.
# "npm run", "npm start" and "npm test" are not affected.
ignore-scripts=true
