# Copy this file to .env and adjust if needed. No secrets are required.
# All services bind to loopback (127.0.0.1) by default.

# --- MCP server (Streamable HTTP) ---
NICK_MCP_HOST=127.0.0.1
NICK_MCP_PORT=3001
# Where the agent backend reaches the MCP server
NICK_MCP_URL=http://127.0.0.1:3001/mcp

# Directory for the local SQLite databases (kept outside the public web folder)
NICK_DATA_DIR=./data

# --- Local AI (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# native = Ollama tool calling, json = validated structured-output adapter, auto = native with JSON fallback
OLLAMA_TOOL_MODE=auto
OLLAMA_TIMEOUT_MS=180000

# --- Agent limits ---
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=8
MCP_TOOL_TIMEOUT_MS=15000
